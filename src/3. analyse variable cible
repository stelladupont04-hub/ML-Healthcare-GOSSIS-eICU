# 3. Visualisation
# Configuration du style
plt.rcParams['font.family'] = 'sans-serif'
fig, axes = plt.subplots(1, 2, figsize=(14, 5), gridspec_kw={'width_ratios': [1.2, 1]})

# Couleurs plus modernes (Bleu acier et Corail doux)
colors = ['#5499C7', '#EC7063']

# A. Barplot
bars = axes[0].bar(['Survivants', 'Décès'], counts.values, color=colors, width=0.6, 
                   edgecolor='black', linewidth=0.8, alpha=0.9)
axes[0].set_title("Distribution du nombre de patients", fontsize=12, fontweight='bold', pad=20)
axes[0].set_ylabel("Effectifs", fontsize=10, labelpad=10)

# Ajout des étiquettes au-dessus des barres
for bar in bars:
    height = bar.get_height()
    axes[0].text(bar.get_x() + bar.get_width()/2., height + (counts[0]*0.02),
                 f'{int(height):,}\n({height/len(y)*100:.1f}%)',
                 ha='center', va='bottom', fontweight='bold', fontsize=10, color='#2c3e50')

# Esthétique du Barplot
axes[0].spines[['top', 'right']].set_visible(False)
axes[0].grid(axis='y', linestyle='--', alpha=0.3)
axes[0].set_ylim(0, counts[0] * 1.2)

# B. Pie chart
# Effet "Donut"
wedges, texts, autotexts = axes[1].pie(
    counts.values, labels=['Survivants', 'Décès'], colors=colors, 
    autopct='%1.1f%%', startangle=140, pctdistance=0.85,
    wedgeprops={'width': 0.4, 'edgecolor': 'white', 'linewidth': 3}
)

# Style des textes du Pie
plt.setp(autotexts, size=10, weight="bold", color="white")
plt.setp(texts, size=11, fontweight='bold')
axes[1].set_title("Répartition relative (%)", fontsize=12, fontweight='bold', pad=20)

# Titre général
plt.suptitle(f"Analyse du déséquilibre des classes : {TARGET}", 
             fontsize=15, fontweight='bold', y=1.05, color='#2c3e50')

plt.tight_layout()
plt.show()
