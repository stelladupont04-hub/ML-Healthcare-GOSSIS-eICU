# 2.6. RANDOM FOREST SUR JEU RÉÉCHANTILLONNÉ (TOP 15)
display(Markdown("## **2.6. Random Forest sur Jeu Rééchantillonné (Top 15)**"))

# 1. Pipeline
pipe_rf_bal = Pipeline([
    ('prep', preprocessor_top15),
    ('clf', RandomForestClassifier(n_estimators=200, random_state=42, n_jobs=-1))
])

# 2. Entraînement sur le jeu réduit (X_train_bal / y_train_bal)
pipe_rf_bal.fit(X_train_bal[top_15_features], y_train_bal)

# 3. Évaluation
y_proba_rf_bal = pipe_rf_bal.predict_proba(X_test_bal[top_15_features])[:, 1]
y_pred_rf_bal  = pipe_rf_bal.predict(X_test_bal[top_15_features])

auc_rf_bal = roc_auc_score(y_test_bal, y_proba_rf_bal)
rec_rf_bal = recall_score(y_test_bal, y_pred_rf_bal)

# 4. Visualisations
fig, axes = plt.subplots(1, 2, figsize=(16, 6))

RocCurveDisplay.from_predictions(y_test_bal, y_proba_rf_bal, 
                                  name=f'RF Rééchantillonné (AUC={auc_rf_bal:.4f})',
                                  ax=axes[0], color='orange', lw=2)
axes[0].plot([0, 1], [0, 1], color='navy', lw=2, linestyle='--')
axes[0].set_title("Courbe ROC - RF Rééchantillonné", fontweight='bold')
axes[0].legend(loc="lower right")

ConfusionMatrixDisplay.from_predictions(y_test_bal, y_pred_rf_bal, 
                                        display_labels=['Survie', 'Décès'], 
                                        cmap='Blues', ax=axes[1], values_format='d')
axes[1].set_title("Matrice de Confusion - RF Rééchantillonné", fontweight='bold')

plt.tight_layout()
plt.show()

