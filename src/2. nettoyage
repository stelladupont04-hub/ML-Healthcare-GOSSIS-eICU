# --- 3. EXÉCUTION DU NETTOYAGE GLOBAL ---

# Suppression des NaN
df = df.dropna(subset=['icu_admit_source'])

# Conversion en Categorical (On enlève dx_sub d'ici car on va la supprimer)
cat_cols = ['partition', 'dcs_group', 'icu_admit_source', 'group', 'dx_class_clean']
for col in cat_cols:
    if col in df.columns:
        df[col] = df[col].astype('category')

# Suppression des IDs, de l'ancienne colonne dx_class, de dx_sub et icu_death
cols_to_drop = ['patientunitstayid', 'encounter_id', 'dx_class', 'dx_sub', 'icu_death']
df = df.drop(columns=cols_to_drop, errors='ignore')

# Définition de la cible
TARGET = 'hospital_death'

# Séparer features et cible
X = df.drop(columns=[TARGET])
y = df[TARGET]

