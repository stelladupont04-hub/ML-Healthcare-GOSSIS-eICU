# --- 4. Valeurs aberrantes (Outliers) ---
display(Markdown("## 4. Valeurs aberrantes"))

# Explication de la méthode
display(Markdown("""
L'analyse ci-dessous identifie les valeurs aberrantes en utilisant la méthode de l'**Écart Interquartile (IQR)**. 
Une valeur est considérée comme aberrante si elle se situe en dehors de l'intervalle :  
`[Q1 - 1.5 * IQR ; Q3 + 1.5 * IQR]`.

*Note : Seules les 15 colonnes présentant le taux d'outliers le plus élevé sont affichées pour faciliter la lecture.*
"""))

num_cols = df.select_dtypes(include='number').columns
outlier_report = []

for col in num_cols:
    Q1 = df[col].quantile(0.25)
    Q3 = df[col].quantile(0.75)
    IQR = Q3 - Q1
    n_out = ((df[col] < Q1 - 1.5 * IQR) | (df[col] > Q3 + 1.5 * IQR)).sum()
    if n_out > 0:
        outlier_report.append({
            'Colonne': col, 
            'Nb outliers': n_out, 
            '% outliers': n_out / len(df) * 100
        })

outlier_df = pd.DataFrame(outlier_report).sort_values('% outliers', ascending=False)

# Affichage du tableau sobre
if not outlier_df.empty:
    display(Markdown(f"**Total : {len(outlier_df)} colonnes contiennent des valeurs aberrantes.**"))
    
    # .style sans couleurs, juste pour le formatage des nombres
    display(outlier_df.head(15).style
            .format({'% outliers': '{:.2f}%', 'Nb outliers': '{:,}'})
            .hide(axis='index'))
else:
    display(Markdown("✅ Aucune valeur aberrante détectée selon la méthode IQR."))
