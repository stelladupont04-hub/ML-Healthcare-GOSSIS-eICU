# 1. Préparation des données
X_train_top15 = X_train[top15_vars]
X_test_top15  = X_test[top15_vars]

preprocessor_top15 = ColumnTransformer(transformers=[
    ('num', StandardScaler(), top15_vars)
])

# 2. Construction du Pipeline
pipe_rf_top15 = Pipeline([
    ('prep', preprocessor_top15),
    ('clf', RandomForestClassifier(
        n_estimators=2000,
        class_weight='balanced',
        n_jobs=-1,
        random_state=42
    ))
])

# 3. Validation croisée stratifiée
cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
cv_rf15 = cross_validate(pipe_rf_top15, X_train_top15, y_train,
                          cv=cv, scoring={'roc_auc': 'roc_auc', 'recall': 'recall'}, n_jobs=-1)

# 4. Entraînement final et calcul des scores
pipe_rf_top15.fit(X_train_top15, y_train)

y_proba_rf15 = pipe_rf_top15.predict_proba(X_test_top15)[:, 1]
y_pred_rf15  = pipe_rf_top15.predict(X_test_top15)

auc_rf15    = roc_auc_score(y_test, y_proba_rf15)
